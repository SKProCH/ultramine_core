apply plugin: 'java' 
apply plugin: 'eclipse'

sourceCompatibility = '1.6'
targetCompatibility = '1.6'

repositories {
	maven {
		name 'forge'
		url 'https://files.minecraftforge.net/maven'
	}
	maven {
		name 'minecraftforge'
		url 'https://maven.minecraftforge.net/'
	}
	mavenCentral()
	maven {
		name 'sonatypeSnapshot'
		url 'https://oss.sonatype.org/content/repositories/snapshots/'
	}
	maven {
		name 'sonatype'
		url 'https://central.sonatype.com/'
	}
	maven {
		name 'minecraft'
		url 'https://libraries.minecraft.net/'
	}
	maven {
		name 'maven2'
		url 'https://repo.maven.apache.org/maven2/'
	}
	maven {
		name 'apache'
		url 'https://maven.apache.org/'
	}
	maven {
		name 'mvnrepository'
		url 'https://mvnrepository.com/'
	}
	maven {
		name 'koloboke-api-jdk8'
		url 'https://mvnrepository.com/artifact/com.koloboke/koloboke-api-jdk8'
	}
	maven {
		name 'koloboke-impl-jdk8'
		url 'https://mvnrepository.com/artifact/com.koloboke/koloboke-impl-jdk8'
	}
	maven {
		name 'log4j-api'
		url 'https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-api'
	}
	maven {
		name 'log4j-core'
		url 'https://mvnrepository.com/artifact/org.apache.logging.log4j/log4j-core'
	}
}

